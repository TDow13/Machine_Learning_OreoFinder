   "source": [
    "# imports\n",
    "import kagglehub\n",
    "from kagglehub import KaggleDatasetAdapter\n",
    "import torch\n",
    "from torchvision import transforms, datasets\n",
    "from torch.utils.data import DataLoader, ConcatDataset\n",
    "import os\n",
    "from pathlib import Path\n",
    "import shutil\n",
    "from sklearn.model_selection import train_test_split\n",
    "from torch.utils.data import Subset\n",
    "import numpy as np\n",
    "from torch.utils.data import DataLoader, WeightedRandomSampler"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e7d18737a8c644a9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# download dataset\n",
    "\n",
    "local_data_path = Path(\"../data\")\n",
    "dataset_base_path = Path(kagglehub.dataset_download(\"crawford/cat-dataset\"))\n",
    "dataset_base_path = dataset_base_path / \"cats\"\n",
    "oreo_path = local_data_path / \"oreo\"\n",
    "not_oreo_path = local_data_path / \"not_oreo\"\n",
    "\n",
    "oreo_path.mkdir(exist_ok=True)\n",
    "not_oreo_path.mkdir(exist_ok=True)\n",
    "\n",
    "for image in local_data_path.glob(\"*.jpg\"):\n",
    "    shutil.move(str(image), str(oreo_path / image.name))\n",
    "\n",
    "for subdir in dataset_base_path.iterdir():\n",
    "    if subdir.is_dir():\n",
    "        for image in subdir.glob(\"*.jpg\"):\n",
    "            new_name = f\"{subdir.name}_{image.name}\"\n",
    "            shutil.move(str(image), str(not_oreo_path / new_name))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "3f6a100f-d9ec-4893-aa09-923b677a37d9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "../data/oreo\n",
      "../data/not_oreo\n"
     ]
    }
   ],
   "source": [
    "print(oreo_path)\n",
    "print(not_oreo_path)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "0b798bc1-0c8a-4349-a312-6ed398f1fdbb",
   "metadata": {
